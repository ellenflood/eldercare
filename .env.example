# Copy to .env.local for local development, or set these directly on the
# Vercel project (Project Settings -> Environment Variables) for deployments.
# Never commit real values -- .env.local and .env* are gitignored.

# Used by src/lib/twilio.ts to start a Studio Flow execution (the outbound
# check-in call) when a child clicks "Call again" on a CheckIn-type alert.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_STUDIO_FLOW_SID=
TWILIO_FROM_NUMBER=
